{
  "name": "knowledgeworks",
  "version": "2.0.1",
  "description": "Desktop automation hub for MediaBridge, ArticleFlow, and future eGain workflows.",
  "author": "grenzk",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server=http://127.0.0.1:5173\"",
    "dev:hub": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-server=http://127.0.0.1:5173 --show-hub\"",
    "build": "npm run typecheck && vite build",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "install:packaging": "npm install --include=peer",
    "dist:win": "npm run build && electron-builder --win --x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "script:articleflow": "node src/tools/articleflow/scripts/run-article-flow.ts",
    "script:media-linking": "node src/tools/mediabridge/scripts/run-media-linking.ts",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=verbose",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "com.mediabridge.toolbar",
    "productName": "KnowledgeWorks",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grenzk",
        "repo": "mediabridge-releases"
      }
    ],
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "src/shared/**/*",
      "src/tools/articleflow/**/*",
      "src/tools/mediabridge/**/*",
      "src/tools/docsweep/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "build/icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/chrome-win64",
          "to": "chrome-win64",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "playwright": "^1.60.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.1": true
  }
}
